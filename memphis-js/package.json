{
  "name": "@fromscratchcode/memphis-js",
  "version": "0.2.1",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,md,css}\"",
    "prepack": "./scripts/prepack.sh"
  },
  "type": "module",
  "description": "JavaScript interface for running the Memphis Python interpreter in WebAssembly.",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js"
    }
  },
  "files": [
    "src",
    "pkg"
  ],
  "devDependencies": {
    "prettier": "^3.5.3"
  }
}
